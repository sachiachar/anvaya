# Gemini via AI Studio (API key). Set GOOGLE_GENAI_USE_VERTEXAI=true only if you move to Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=your-ai-studio-key
GOOGLE_CLOUD_PROJECT=your-project-id

# Models (check the model list in Vertex AI and pick the latest available)
GEMINI_FLASH_MODEL=gemini-3.1-flash-lite
GEMINI_PRO_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODELS=gemini-3.8-flash-lite-tts,gemini-3.8-flash-tts,gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Sulafat
GEMINI_LIVE_MODEL=gemini-3.8-live
# Fraud pipeline: imagines attacks and checks them against web pages (registry: fraud.dreamer, fraud.researcher)
GEMINI_RESEARCH_MODEL=gemini-3.8-flash
# Web search for fraud research (exa.ai). Empty: research says web search isn't set up yet.
# On Cloud Run it comes from the GitHub secret EXA_API_KEY (environment "production").
EXA_API_KEY=

# file = local demo (survives restarts); memory = tests; firestore = on Google Cloud
STORE=file

# Leave empty locally (dev mode). On Cloud Run set to the vault escrow key:
# projects/PROJECT/locations/asia-southeast1/keyRings/life-after/cryptoKeys/vault-escrow
KMS_KEY_NAME=

# Model keys people add themselves (PR-10.10) are encrypted with this KMS key, separate from the
# vault's. Leave empty locally (dev mode). On Cloud Run: the model-keys key, from the repository
# variable MODEL_KEYS_KMS_KEY_NAME. Empty with STORE=firestore: people can't save their own key.
# projects/PROJECT/locations/asia-southeast1/keyRings/life-after/cryptoKeys/model-keys
MODEL_KEYS_KMS_KEY_NAME=

# Leave empty locally; on Cloud Run set to a private bucket
MEDIA_BUCKET=

# Vault release waiting period in seconds (demo: 60; production: days)
RELEASE_WAIT_SECONDS=60

CORS_ORIGINS=http://localhost:5173

# Sign-in (Firebase Auth) and the demo allowlist: emails and/or @domains, comma-separated
AUTH_REQUIRED=true
FIREBASE_PROJECT_ID=your-project-id
ALLOWED_EMAILS=you@example.com,@yourcompany.com

# Admin portal spend: the Cloud Billing export to BigQuery, as project.dataset (the detailed
# usage cost table is found there) or project.dataset.table. Empty: "billing data not available yet".
# The service account needs BigQuery Data Viewer on the dataset and BigQuery Job User on the project.
BILLING_EXPORT_TABLE=
MONTHLY_BUDGET_USD=300
