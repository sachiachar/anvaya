# Firebase web config (public values). Copy to web/.env; get them with:
#   firebase apps:sdkconfig web --project <project-id>
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<project-id>
VITE_FIREBASE_APP_ID=

# Live calls: Firebase Hosting can't proxy WebSockets, so production points at the Cloud Run URL
# (the deploy workflow sets it). Empty locally: the call uses this page's host.
# VITE_LIVE_URL=wss://<service>.a.run.app
# The admin portal's address. Empty: /admin.html locally, https://anvaya-admin.web.app in a build.
# VITE_ADMIN_URL=
