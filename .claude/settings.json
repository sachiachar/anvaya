{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run --group dev pytest:*)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(uv run --group dev ruff check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git switch -c:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(uv add:*)",
      "Bash(npm install:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Bash(cat:*.env)",
      "Bash(gcloud run deploy:*)",
      "Bash(firebase deploy:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git.sh" }
        ]
      }
    ]
  }
}
